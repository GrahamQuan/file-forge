{
  "name": "file-forge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build",
    "test:e2e": "pnpm build && vitest run",
    "file-forge": "sh packages/cli/dist/launcher.js",
    "package:runtime": "pnpm build && node packages/cli/dist/archive.js",
    "skill:copy": "node packages/cli/dist/copy-skill.js"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.2",
    "@file-forge/media": "workspace:*",
    "@types/node": "^24.0.0",
    "effect": "4.0.2",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "sharp": "0.35.4",
    "turbo": "2.11.3",
    "typescript": "~7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.33.0"
}
