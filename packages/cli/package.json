  "dependencies": {
    "@effect/platform-node": "4.0.2",
    "@file-forge/core": "workspace:*",
    "@file-forge/mcp": "workspace:*",
    "@file-forge/media": "workspace:*",
    "effect": "4.0.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
