{
  "name": "@file-forge/cli",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "file-forge": "dist/launcher.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-launcher.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
